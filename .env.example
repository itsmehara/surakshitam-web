# Copy to .env.local and fill in. .env.local is git-ignored — never commit real tokens.

# Instagram Graph API — powers the homepage reels feed with real thumbnails.
# Without these, the feed falls back to hand-picked reel links (still works).
# See ../surakshitam-docs/docs/INSTAGRAM_SETUP.md for how to get these.
INSTAGRAM_ACCESS_TOKEN=
# Optional: your Instagram user id. Leave blank to use "me".
INSTAGRAM_USER_ID=
